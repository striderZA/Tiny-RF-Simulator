#!/usr/bin/env bash
# Blocks commits that would fail the release workflow's `format` job (see .github/workflows/release.yml)
# and commits whose staged diff exceeds the size cap (CONTRIBUTING.md, Git Workflow > Commits).
# Enable once per clone with:  git config core.hooksPath .githooks
set -u

# Staged size check: insertions + deletions of the staged diff, binary files excluded. A deleted
# file counts as one line. Above WARN_COMMIT_LINES the commit goes ahead with a warning; above
# MAX_COMMIT_LINES it is blocked. It runs before the format check so it covers every commit, not
# only C++ ones. A merge in progress is exempt because its changes were already committed on the
# merged branch.
WARN_COMMIT_LINES=100
MAX_COMMIT_LINES=200
if [ -z "${RFSIM_ALLOW_LARGE_COMMIT:-}" ] && ! git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
  STAT="$(git diff --cached --numstat --diff-filter=d)"
  DELETED="$(git diff --cached --name-only --diff-filter=D | grep -c . || true)"
  LINES="$(printf '%s\n' "$STAT" | awk '$1 != "-" { n += $1 + $2 } END { print n + 0 }')"
  LINES=$((LINES + DELETED))
  if [ "$LINES" -gt "$MAX_COMMIT_LINES" ]; then
    {
      echo "pre-commit: this commit changes ${LINES} lines; the limit is ${MAX_COMMIT_LINES} (insertions + deletions; a deleted file counts as 1)."
      echo
      echo "Largest files in the commit:"
      printf '%s\n' "$STAT" | awk '$1 != "-" { print ($1 + $2) "\t" $3 }' | sort -rn | head -5 | sed 's/^/  /'
      echo
      echo "Split it into commits of one logical change each: unstage with 'git reset', then stage"
      echo "and commit one part at a time (git add -p)."
      echo "To allow this one commit (NOT recommended):  RFSIM_ALLOW_LARGE_COMMIT=1 git commit ..."
    } >&2
    exit 1
  fi
  if [ "$LINES" -gt "$WARN_COMMIT_LINES" ]; then
    echo "pre-commit: warning: this commit changes ${LINES} lines (warning above ${WARN_COMMIT_LINES}, blocked above ${MAX_COMMIT_LINES}); consider splitting it." >&2
  fi
fi

# The checked directory set is defined once in scripts/format-dirs.sh, shared
# with scripts/format.sh and the release workflow's format job.
source "$(git rev-parse --show-toplevel)/scripts/format-dirs.sh"
# Staged, non-deleted .cpp/.h files under the CI-checked directories. Check this FIRST so
# commits that touch no C++ (docs, scripts, CI config, ...) never require clang-format at all.
mapfile -t FILES < <(git diff --cached --name-only --diff-filter=ACMR -- "${FORMAT_DIRS[@]}" \
  | grep -E '\.(cpp|h)$' || true)

if [ "${#FILES[@]}" -eq 0 ]; then
  exit 0
fi

# clang-format discovery is shared with scripts/format.sh (accepts major >= 18).
source "$(git rev-parse --show-toplevel)/scripts/clang-format-resolve.sh"

CF="$(resolve_clang_format)"
if [ -z "$CF" ]; then
  cat >&2 <<EOF
pre-commit: clang-format ${CLANG_FORMAT_MIN_MAJOR}+ not found on PATH, but this commit touches C++ files:
$(printf '  %s\n' "${FILES[@]}")

Install it, then retry the commit:
  Linux (apt):    sudo apt-get install -y clang-format-18
  macOS (brew):   brew install llvm@18   # ensure its bin/ is on PATH
  Any platform:   scripts/install-clang-format.sh  (pip install clang-format==18.1.8)

To skip this check for one commit (NOT recommended, CI will still enforce it):
  git commit --no-verify
EOF
  exit 1
fi

BAD=()
for f in "${FILES[@]}"; do
  [ -f "$f" ] || continue
  if ! "$CF" --dry-run --Werror "$f" >/dev/null 2>&1; then
    BAD+=("$f")
  fi
done

if [ "${#BAD[@]}" -gt 0 ]; then
  echo "pre-commit: clang-format violations in ${#BAD[@]} file(s) (would fail CI's format job):" >&2
  printf '  %s\n' "${BAD[@]}" >&2
  echo "Fix with: ${CF} -i ${BAD[*]}" >&2
  exit 1
fi

exit 0
