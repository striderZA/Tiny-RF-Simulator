#!/usr/bin/env bash
# Enforces the commit-message format documented in CONTRIBUTING.md (Git Workflow > Commits).
# Enable once per clone with:  git config core.hooksPath .githooks
# Local only: commits created server-side (GitHub squash merge) never run it.
set -u

MSG_FILE="${1:-}"
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
  exit 0
fi

# Only the subject (first non-empty message line) is validated. Drop git's comment
# block and the scissors section that `git commit --verbose` appends, then take it.
# CRs are stripped so a CRLF-editor message is not counted as one character longer.
SUBJECT="$(sed -e '/^# -\{2,\} >8 -\{2,\}/,$d' -e '/^#/d' "$MSG_FILE" | tr -d '\r' | awk 'NF { print; exit }')"

# An empty message is rejected by git itself; nothing to add here.
if [ -z "$SUBJECT" ]; then
  exit 0
fi

# Merge, revert, and autosquash subjects are generated by git, not authored, and a
# merge in progress may carry an author-supplied message: never block those.
case "$SUBJECT" in
  "Merge "* | "Revert "* | "fixup! "* | "squash! "*) exit 0 ;;
esac
if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
  exit 0
fi

TYPES='build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test'
MAX_SUBJECT_LEN=69

reject() {
  {
    echo "commit-msg: rejected commit message (see CONTRIBUTING.md, Git Workflow > Commits)"
    echo
    echo "  subject: ${SUBJECT}"
    echo
    printf '%s\n' "$@"
    echo
    echo "Format: <type>[(scope)][!]: <subject>   with type one of: ${TYPES//|/, }"
    echo "To bypass this check for one commit (NOT recommended):  git commit --no-verify"
  } >&2
  exit 1
}

if [ "${#SUBJECT}" -gt "$MAX_SUBJECT_LEN" ]; then
  reject "Subject is ${#SUBJECT} characters; keep it under 70."
fi

if ! printf '%s\n' "$SUBJECT" | grep -Eq "^(${TYPES})(\([a-z0-9][a-z0-9._/-]*\))?!?: [^[:space:]]"; then
  reject "Subject must be '<type>[(scope)][!]: <imperative summary>'." \
    "Examples: 'fix: guard empty tone list', 'test(pfb): cover grid invariance'."
fi

exit 0
